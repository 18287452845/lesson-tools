# Environment variables for Lesson Plan Tool

# ==========================================
# AI Provider Configuration
# ==========================================

# AI Provider: 'deepseek' or 'anthropic'
# Default: deepseek (推荐 - 性价比高，中文优秀)
AI_PROVIDER=deepseek

# Optional: Override the default model
# DeepSeek models: deepseek-v4-flash, deepseek-v4-pro
# Anthropic models: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# AI_MODEL=

# DeepSeek OpenAI-compatible API base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek API Key (获取地址: https://platform.deepseek.com/)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Anthropic API Key for Claude AI (获取地址: https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ==========================================
# Database Configuration
# ==========================================

# Database Path (relative to backend directory)
DATABASE_PATH=./storage/database.db

# ==========================================
# Storage Directories
# ==========================================

TEMPLATE_DIR=./storage/templates
UPLOAD_DIR=./storage/uploads
OUTPUT_DIR=./storage/outputs

# ==========================================
# API Configuration
# ==========================================

API_HOST=127.0.0.1
API_PORT=8000

# ==========================================
# External Textbook Discovery (Optional)
# ==========================================

# Google Books works without a key at low volume, but a key improves quota stability.
GOOGLE_BOOKS_API_KEY=
AIJIAOCAI_BASE_URL=https://www.aijiaocai.com
BOOK_SEARCH_TIMEOUT=15.0
BOOK_SEARCH_MAX_RESULTS=8
BOOK_SEARCH_USER_AGENT=YunlinLessonTools/1.1 (educational textbook discovery)

# ==========================================
# AI Generation Parameters
# ==========================================

AI_MAX_TOKENS=0

# AI Max Tokens for Batch Generation (chapter splitting)
# 0 omits max_tokens so the provider/model output limit applies.
AI_MAX_TOKENS_BATCH=0

AI_TEMPERATURE=0.7

# AI Request Timeout (seconds)
# Default: 180.0 (3 minutes)
# Increase this if you experience timeouts during chapter generation
AI_TIMEOUT=180.0

# ==========================================
# AI Retry Settings
# ==========================================

# Maximum number of retry attempts for failed AI requests (default: 2)
# Set to 0 to disable retry logic
# Each retry counts as an additional attempt (2 retries = 3 total attempts)
AI_MAX_RETRIES=2

# Initial delay before first retry in seconds (default: 1.0)
# Delay increases exponentially with each retry
AI_RETRY_DELAY=1.0

# Exponential backoff multiplier (default: 2.0)
# Retry delays: 1s -> 2s -> 4s -> 8s...
# Lower values (e.g., 1.0) = constant delay between retries
AI_RETRY_BACKOFF=2.0

# ==========================================
# Batch Generation Concurrency Settings
# ==========================================

# Maximum number of documents to generate concurrently (default: 5)
# Each document typically contains 2 lesson plans
# Lower this value if you encounter API rate limiting
BATCH_MAX_CONCURRENT_DOCUMENTS=5

# Maximum number of lesson plans to generate concurrently within documents (default: 10)
# This controls the number of simultaneous AI API calls
# Higher values = faster generation but more API usage
BATCH_MAX_CONCURRENT_LESSONS=10

# HTTP connection pool size for batch processing (default: 50)
# Reuses connections to reduce TCP handshake overhead
BATCH_CONNECTION_POOL_SIZE=50

# HTTP connection keepalive timeout in seconds (default: 30.0)
# Connections idle longer than this will be closed
BATCH_CONNECTION_KEEPALIVE=30.0
