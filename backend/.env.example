# Environment variables for Lesson Plan Tool

# ==========================================
# AI Provider Configuration
# ==========================================

# AI Provider: 'deepseek' or 'anthropic'
# Default: deepseek (推荐 - 性价比高，中文优秀)
AI_PROVIDER=deepseek

# Optional: Override the default model
# DeepSeek models: deepseek-chat, deepseek-coder
# Anthropic models: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# AI_MODEL=

# DeepSeek API Key (获取地址: https://platform.deepseek.com/)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Anthropic API Key for Claude AI (获取地址: https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ==========================================
# Database Configuration
# ==========================================

# Database Path (relative to backend directory)
DATABASE_PATH=./storage/database.db

# ==========================================
# Storage Directories
# ==========================================

TEMPLATE_DIR=./storage/templates
UPLOAD_DIR=./storage/uploads
OUTPUT_DIR=./storage/outputs

# ==========================================
# API Configuration
# ==========================================

API_HOST=127.0.0.1
API_PORT=8000

# ==========================================
# AI Generation Parameters
# ==========================================

AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
