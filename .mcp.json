{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless=true",
        "--viewport",
        "1920x1080",
        "--isolated"
      ],
      "env": {
        "DEBUG": "chrome-devtools-mcp:info"
      }
    }
  }
}
