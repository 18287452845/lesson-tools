# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual Environment
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
logs/

# Environment variables (will be passed via docker-compose)
.env
.env.local

# Node.js
node_modules/
npm-debug.log*

# Git
.git/
.gitignore
.gitattributes

# Storage (will be mounted as volume)
storage/uploads/
storage/outputs/
storage/exports/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
nul

# Test and debug scripts
test_*.py
test_*.sh
check_*.py
debug_*.py

# Development reports
*_REPORT.md
*_GUIDE.md
*_SUMMARY.md
*_FIX*.md
DEBUG_*.md

# Docker files (avoid recursive copy)
Dockerfile
docker-compose*.yml
.dockerignore

# Frontend build artifacts (will be built in container)
frontend/dist/
frontend/dist-electron/
frontend/.vite/

# CI/CD
.github/
.gitlab-ci.yml

# Documentation (optional, comment out if you want to include)
*.md
!README.md
