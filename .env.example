# ====================
# AI Provider Configuration
# ====================

# AI provider to use: 'deepseek' or 'anthropic'
AI_PROVIDER=deepseek

# DeepSeek API Configuration
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API Configuration (Optional)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ====================
# API Server Configuration (Optional)
# ====================

# API host (default: 0.0.0.0)
API_HOST=0.0.0.0

# API port (default: 8000)
API_PORT=8000

# ====================
# AI Model Configuration (Optional)
# ====================

# Model to use (default: deepseek-chat for DeepSeek, claude-3-5-sonnet-20241022 for Anthropic)
# DeepSeek models: deepseek-chat, deepseek-coder
# Anthropic models: claude-3-5-sonnet-20241022, claude-3-opus-20240229
AI_MODEL=deepseek-chat

# Maximum tokens for AI responses (default: 4096)
AI_MAX_TOKENS=4096

# Temperature for AI generation (0.0-1.0, default: 0.7)
# Lower values = more focused, higher values = more creative
AI_TEMPERATURE=0.7

# ====================
# Database Configuration
# ====================

# SQLite database path (default: sqlite:///storage/database.db)
DATABASE_URL=sqlite:///storage/database.db

# ====================
# Docker Deployment Notes
# ====================

# 1. Copy this file to .env and fill in your actual API keys:
#    cp .env.example .env
#
# 2. Edit .env and replace the placeholder values with your actual keys
#
# 3. Start the application:
#    docker-compose up -d
#
# 4. Access the application:
#    Frontend: http://localhost
#    Backend API: http://localhost:8000
#    API Docs: http://localhost:8000/docs
#
# 5. View logs:
#    docker-compose logs -f
#
# 6. Stop the application:
#    docker-compose down
