# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts should always use LF
*.sh text eol=lf

# Batch files should use CRLF
*.bat text eol=crlf

# Python files should use LF
*.py text eol=lf

# Configuration files
*.ini text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Markdown files
*.md text eol=lf

# Docker files
Dockerfile text eol=lf
*.dockerfile text eol=lf
docker-compose.yml text eol=lf

# Git files
.gitignore text eol=lf
.gitattributes text eol=lf
